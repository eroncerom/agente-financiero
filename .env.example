# Puerto del servidor (por defecto 3001)
PORT=3001

# Ruta de la base de datos SQLite (en Docker apunta al volumen persistente /app/data/portfolio.db)
DB_PATH=/app/data/portfolio.db

# Clave API opcional para el Asistente Cuantitativo IA (también configurable desde la interfaz web)
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Sembrar posiciones de demostración si la cartera está vacía (true / false)
SEED_DEMO_DATA=false
